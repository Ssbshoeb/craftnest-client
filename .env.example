# CraftNest admin panel (Vuexy / Vite)
#
# Copy to `.env` and adjust. Vite reads these at BUILD time, so after changing
# them you have to restart `npm run dev` (or rebuild) - a running dev server
# will not pick up a new value on its own.

# Laravel API root, including the /api prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Where uploaded images are served from - the API's /storage symlink.
# Product photos are stored as relative paths, so this is what turns
# `products/abc.jpg` into a URL the browser can load.
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000/storage/
